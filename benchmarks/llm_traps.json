{
  "_comment": "LLM-trap set — classic error patterns that LLMs frequently FALL INTO. Each entry: the WRONG answer an LLM might give + the correct verdict MathHead uses to catch it. The harness runs route(task, payload) and checks the 'expect' fields; a match = TRAP CAUGHT. HONEST framing: this is a reproducible demonstration that MathHead correctly adjudicates known error patterns — NOT a live LLM A/B (that runs on the user side).",
  "traps": [
    {"id": "incomplete-quadratic", "category": "incomplete_solution",
     "llm_error": "gives only x=2 for x²=4, misses x=-2",
     "task": "verify_solution",
     "payload": {"equation": "x**2 == 4", "symbol": "x", "claimed": ["2"]},
     "expect": {"status": "invalid", "reason_code": "SOLUTION_INCOMPLETE"}},

    {"id": "incomplete-quartic", "category": "incomplete_solution",
     "llm_error": "gives {2} for x⁴=16; misses -2 (and the complex roots)",
     "task": "verify_solution",
     "payload": {"equation": "x**4 == 16", "symbol": "x", "claimed": ["2"]},
     "expect": {"status": "invalid", "reason_code": "SOLUTION_INCOMPLETE"}},

    {"id": "wrong-root", "category": "wrong_solution",
     "llm_error": "wrongly adds 3 to the solution set of x²=4",
     "task": "verify_solution",
     "payload": {"equation": "x**2 == 4", "symbol": "x", "claimed": ["2", "3"]},
     "expect": {"status": "invalid", "reason_code": "SOLUTION_INCORRECT"}},

    {"id": "false-identity-square", "category": "false_identity",
     "llm_error": "thinks (x+1)² = x²+1 (forgets the cross term 2x)",
     "task": "cross_check",
     "payload": {"left": "(x+1)**2", "right": "x**2 + 1"},
     "expect": {"status": "invalid", "reason_code": "CONSENSUS_NOT_EQUAL"}},

    {"id": "domain-trap-cancel", "category": "domain_trap",
     "llm_error": "says (x²-1)/(x-1) = x+1, skips the undefined point at x=1",
     "task": "verify_equality",
     "payload": {"left": "(x**2 - 1)/(x - 1)", "right": "x + 1"},
     "expect": {"status": "valid", "reason_code": "EQUAL_ON_COMMON_DOMAIN"}},

    {"id": "domain-trap-crosscheck", "category": "domain_trap",
     "llm_error": "assumes the same simplification is unconditionally true",
     "task": "cross_check",
     "payload": {"left": "(x**2 - 1)/(x - 1)", "right": "x + 1"},
     "expect": {"status": "unknown", "reason_code": "ENGINES_DISAGREE"}},

    {"id": "false-inequality", "category": "false_inequality",
     "llm_error": "thinks x² ≥ x holds for all real x (forgets 0<x<1)",
     "task": "prove_inequality",
     "payload": {"goal": "x**2 >= x"},
     "expect": {"status": "invalid", "reason_code": "COUNTEREXAMPLE_FOUND"}},

    {"id": "root-branch", "category": "root_branch",
     "llm_error": "thinks √(x²) = x (actually |x|, wrong for x<0)",
     "task": "verify_equality",
     "payload": {"left": "sqrt(x**2)", "right": "x"},
     "expect": {"status": "invalid", "reason_code": "NOT_EQUAL"}},

    {"id": "bad-derivation-step", "category": "bad_step",
     "llm_error": "writes 2·(x+3) = 2x+3 (distributes only halfway)",
     "task": "verify_steps",
     "payload": {"steps": ["2*(x + 3)", "2*x + 3"]},
     "expect": {"status": "invalid", "reason_code": "STEP_INVALID"}},

    {"id": "composite-mistaken-prime", "category": "primality",
     "llm_error": "thinks 91 is prime (actually 7·13)",
     "task": "is_prime",
     "payload": {"n": "91"},
     "expect": {"status": "ok", "result": false}},

    {"id": "power-approximation", "category": "arithmetic",
     "llm_error": "thinks 2¹⁰ is 1000 (actually 1024)",
     "task": "verify_equality",
     "payload": {"left": "2**10", "right": "1000"},
     "expect": {"status": "invalid", "reason_code": "NOT_EQUAL"}},

    {"id": "modular-inverse-nonexistent", "category": "modular",
     "llm_error": "fabricates the inverse of 4 mod 8 (none exists, gcd≠1)",
     "task": "modular_inverse",
     "payload": {"a": "4", "m": "8"},
     "expect": {"status": "error", "reason_code": "COMPUTE_FAILED"}},

    {"id": "diophantine-no-solution", "category": "integer_solution",
     "llm_error": "fabricates an integer solution to 2x+4y=5 (gcd(2,4)=2 ∤ 5)",
     "task": "linear_diophantine",
     "payload": {"a": "2", "b": "4", "c": "5"},
     "expect": {"status": "ok", "result": []}},

    {"id": "deriv-product-rule", "category": "calculus_derivative",
     "llm_error": "differentiates x·sin(x) as just cos(x) (forgets the product rule)",
     "task": "verify_derivative",
     "payload": {"expression": "x*sin(x)", "symbol": "x", "claimed": "sin(x)", "order": 1},
     "expect": {"status": "invalid", "reason_code": "NOT_EQUAL"}},

    {"id": "integral-wrong", "category": "calculus_integral",
     "llm_error": "claims ∫ln(x)dx = 1/x (confuses integral with derivative-ish)",
     "task": "verify_integral",
     "payload": {"expression": "log(x)", "symbol": "x", "claimed": "1/x"},
     "expect": {"status": "invalid", "reason_code": "NOT_EQUAL"}},

    {"id": "limit-one-half", "category": "calculus_limit",
     "llm_error": "says lim x→0 (1-cos x)/x² = 1 (it is 1/2)",
     "task": "verify_limit",
     "payload": {"expression": "(1-cos(x))/x**2", "symbol": "x", "point": "0", "claimed": "1"},
     "expect": {"status": "invalid", "reason_code": "NOT_EQUAL"}},

    {"id": "trig-double-angle", "category": "false_identity",
     "llm_error": "thinks sin(2x) = 2·sin(x) (drops the cos(x) factor)",
     "task": "verify_equality",
     "payload": {"left": "sin(2*x)", "right": "2*sin(x)"},
     "expect": {"status": "invalid", "reason_code": "NOT_EQUAL"}},

    {"id": "log-of-sum", "category": "false_identity",
     "llm_error": "thinks log(x+y) = log(x) + log(y) (that's log of a PRODUCT)",
     "task": "verify_equality",
     "payload": {"left": "log(x+y)", "right": "log(x)+log(y)"},
     "expect": {"status": "invalid", "reason_code": "NOT_EQUAL"}},

    {"id": "strict-positive-forgets-zero", "category": "false_inequality",
     "llm_error": "claims x² > 0 for ALL real x (forgets x=0 gives 0)",
     "task": "prove_inequality",
     "payload": {"goal": "x**2 > 0"},
     "expect": {"status": "invalid", "reason_code": "COUNTEREXAMPLE_FOUND"}},

    {"id": "modal-T-axiom-in-K", "category": "modal_logic",
     "llm_error": "thinks □p → p is valid in system K (it needs reflexivity, system T)",
     "task": "check_modal",
     "payload": {"formula": "implies(box(p), p)", "system": "K"},
     "expect": {"status": "invalid", "reason_code": "COUNTERMODEL_FOUND"}},

    {"id": "bitvector-or-equals-add", "category": "bitvector",
     "llm_error": "thinks (x | y) == (x + y) for all bit-vectors (fails when bits overlap)",
     "task": "check_bitvector",
     "payload": {"assumptions": [], "goal": "(x | y) == (x + y)"},
     "expect": {"status": "invalid", "reason_code": "COUNTEREXAMPLE_FOUND"}},

    {"id": "mersenne-2047-not-prime", "category": "primality",
     "llm_error": "thinks 2047 = 2¹¹−1 is prime (it is 23·89)",
     "task": "is_prime",
     "payload": {"n": "2047"},
     "expect": {"status": "ok", "result": false}},

    {"id": "correct-identity-not-flagged", "category": "true_positive",
     "llm_error": "(control) must NOT wrongly flag a CORRECT identity",
     "task": "cross_check",
     "payload": {"left": "sin(x)**2 + cos(x)**2", "right": "1"},
     "expect": {"status": "valid"}}
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/canonical-normalization-rules-v1.schema.json",
  "title": "MathHead canonical normalization rule catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "mathhead.canonical-normalization-rules.v1"
    },
    "catalogue_id": {
      "const": "mathhead.canonical-normalization-rules.v1"
    },
    "policy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "mathematical_authority": {
      "const": false
    }
  },
  "required": [
    "schema",
    "catalogue_id",
    "policy",
    "rules",
    "mathematical_authority"
  ],
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^mh[.]canonical[.][a-z0-9_.-]+$",
          "maxLength": 128
        },
        "rule_kind": {
          "enum": [
            "alpha",
            "commutative",
            "ordering",
            "preserve"
          ]
        },
        "match_registry": {
          "enum": [
            "variables",
            "definitions",
            "relations",
            "statements",
            "assumption_facts",
            "local_hypotheses",
            "witness_placeholders",
            "any"
          ]
        },
        "match_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "match_value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "minimum_arity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "maximum_arity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 400000
        },
        "effect": {
          "enum": [
            "replace_bound_reference",
            "replace_parameter_reference",
            "replace_witness_reference",
            "sort_operands",
            "sort_occurrences",
            "preserve_order",
            "preserve_opaque"
          ]
        },
        "authority_basis": {
          "enum": [
            "lexical_scope_semantics",
            "core_problem_ir_semantics",
            "representation_policy"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "supported": {
          "type": "boolean"
        },
        "mathematical_authority": {
          "const": false
        }
      },
      "required": [
        "rule_id",
        "rule_kind",
        "match_registry",
        "match_kind",
        "match_value",
        "minimum_arity",
        "maximum_arity",
        "effect",
        "authority_basis",
        "description",
        "supported",
        "mathematical_authority"
      ]
    }
  }
}

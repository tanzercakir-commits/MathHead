{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/capability-cost-derivation-v1.schema.json",
  "title": "MathHead Capability Cost Derivation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "base", "variable_term", "expression_node_term", "quantifier_term", "goal_term", "ambiguity_term", "unsaturated_total", "maximum", "estimated_cost", "saturated", "confidence_ppm", "cost_sha256", "mathematical_authority"],
  "properties": {
    "schema": {"const": "mathhead.capability-cost-derivation.v1"},
    "base": {"$ref": "#/$defs/quantity"}, "variable_term": {"$ref": "#/$defs/quantity"}, "expression_node_term": {"$ref": "#/$defs/quantity"}, "quantifier_term": {"$ref": "#/$defs/quantity"}, "goal_term": {"$ref": "#/$defs/quantity"}, "ambiguity_term": {"$ref": "#/$defs/quantity"},
    "unsaturated_total": {"$ref": "#/$defs/quantity"}, "maximum": {"$ref": "#/$defs/quantity"}, "estimated_cost": {"$ref": "#/$defs/quantity"}, "saturated": {"type": "boolean"}, "confidence_ppm": {"type": "integer", "minimum": 1, "maximum": 1000000}, "cost_sha256": {"$ref": "#/$defs/sha256"}, "mathematical_authority": {"const": false}
  },
  "$defs": {"quantity": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

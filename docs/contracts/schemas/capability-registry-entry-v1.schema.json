{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/capability-registry-entry-v1.schema.json",
  "title": "MathHead Capability Registry Entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "descriptor_sha256", "plugin_id", "plugin_version", "implementation_sha256", "producer_component_id", "checker_component_id", "capability_ids", "dependency_descriptor_sha256s", "entry_sha256", "mathematical_authority"],
  "properties": {
    "schema": {"const": "mathhead.capability-registry-entry.v1"},
    "descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "plugin_id": {"$ref": "#/$defs/namespaced"},
    "plugin_version": {"$ref": "#/$defs/semver"},
    "implementation_sha256": {"$ref": "#/$defs/sha256"},
    "producer_component_id": {"$ref": "#/$defs/id"},
    "checker_component_id": {"$ref": "#/$defs/id"},
    "capability_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "dependency_descriptor_sha256s": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "entry_sha256": {"$ref": "#/$defs/sha256"},
    "mathematical_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$"},
    "namespaced": {"type": "string", "minLength": 3, "maxLength": 255, "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"},
    "semver": {"type": "string", "minLength": 5, "maxLength": 64, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}
  }
}

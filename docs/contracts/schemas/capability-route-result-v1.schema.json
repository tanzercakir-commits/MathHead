{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/capability-route-result-v1.schema.json",
  "title": "MathHead Capability Route Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_id", "contract_sha256", "theory_plugin_contract_sha256", "canonical_normalization_contract_sha256", "problem_session_contract_sha256", "status", "reason_code", "diagnostic", "request_sha256", "registry", "fragment", "candidates", "incompatibilities", "selected_candidate_sha256", "result_sha256", "mathematical_authority"],
  "properties": {
    "schema": {"const": "mathhead.capability-route-result.v1"}, "contract_id": {"const": "MH-C-CAPABILITY-REGISTRY-001"}, "contract_sha256": {"$ref": "#/$defs/sha256"}, "theory_plugin_contract_sha256": {"$ref": "#/$defs/sha256"}, "canonical_normalization_contract_sha256": {"$ref": "#/$defs/sha256"}, "problem_session_contract_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["routed", "unsupported", "ambiguous", "invalid", "exhausted"]}, "reason_code": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Z][A-Z0-9_]*$"}, "diagnostic": {"type": "string", "maxLength": 1024}, "request_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "registry": {"oneOf": [{"type": "null"}, {"type": "object"}]}, "fragment": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fragment"}]}, "candidates": {"type": "array", "maxItems": 1000000, "items": {"type": "object"}}, "incompatibilities": {"type": "array", "maxItems": 1000000, "items": {"type": "object"}}, "selected_candidate_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "result_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "mathematical_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "namespaced": {"type": "string", "minLength": 3, "maxLength": 255, "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"},
    "fragment": {"type": "object", "additionalProperties": false, "required": ["schema", "theories", "domains", "quantifiers", "expression_kinds", "relation_kinds", "polynomial_degree", "quantifier_count", "quantifier_depth", "variables", "expression_nodes", "goals", "ambiguous", "exact_arithmetic", "theory_features", "fragment_sha256", "mathematical_authority"], "properties": {"schema": {"const": "mathhead.capability-fragment.v1"}, "theories": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/namespaced"}}, "domains": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "quantifiers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "expression_kinds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/namespaced"}}, "relation_kinds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/namespaced"}}, "polynomial_degree": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "quantifier_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "quantifier_depth": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "variables": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "expression_nodes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "goals": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "ambiguous": {"type": "boolean"}, "exact_arithmetic": {"type": "boolean"}, "theory_features": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/namespaced"}}, "fragment_sha256": {"$ref": "#/$defs/sha256"}, "mathematical_authority": {"const": false}}}
  }
}

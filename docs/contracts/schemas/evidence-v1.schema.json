{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/evidence-v1.schema.json",
  "title": "MathHead Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_id",
    "subject",
    "format",
    "producer",
    "payloads",
    "primary_payload_id",
    "dependencies",
    "generation",
    "budget",
    "outcome",
    "diagnostics",
    "extensions"
  ],
  "properties": {
    "schema": {"const": "mathhead.evidence.v1"},
    "evidence_id": {"$ref": "#/$defs/id"},
    "subject": {"$ref": "#/$defs/subject"},
    "format": {"$ref": "#/$defs/format"},
    "producer": {"$ref": "#/$defs/producer"},
    "payloads": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/payload"}
    },
    "primary_payload_id": {
      "anyOf": [
        {"$ref": "#/$defs/id"},
        {"type": "null"}
      ]
    },
    "dependencies": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/dependency"}
    },
    "generation": {"$ref": "#/$defs/generation"},
    "budget": {"$ref": "#/$defs/budget"},
    "outcome": {"$ref": "#/$defs/outcome"},
    "diagnostics": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/diagnostic"}
    },
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "quantity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "namespaced": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "id_set": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "sha_set": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "namespaced_set": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/namespaced"}
    },
    "canonical_value": {
      "anyOf": [
        {"type": "null"},
        {"type": "boolean"},
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {"type": "string"},
        {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/canonical_value"}
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {"$ref": "#/$defs/canonical_value"}
        }
      ]
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/namespaced"},
      "additionalProperties": {"$ref": "#/$defs/canonical_value"}
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subject_id",
        "statement_sha256",
        "problem_ir_sha256",
        "theory_context_sha256",
        "reading_id",
        "assumption_sha256s",
        "obligation_sha256s"
      ],
      "properties": {
        "kind": {"enum": ["goal", "obligation", "claim", "result"]},
        "subject_id": {"$ref": "#/$defs/id"},
        "statement_sha256": {"$ref": "#/$defs/sha256"},
        "problem_ir_sha256": {"$ref": "#/$defs/sha256"},
        "theory_context_sha256": {"$ref": "#/$defs/sha256"},
        "reading_id": {"$ref": "#/$defs/id"},
        "assumption_sha256s": {"$ref": "#/$defs/sha_set"},
        "obligation_sha256s": {"$ref": "#/$defs/sha_set"}
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "format_id",
        "version",
        "major",
        "minor",
        "reader_minimum_minor",
        "schema_sha256",
        "canonicalization",
        "features"
      ],
      "properties": {
        "kind": {
          "enum": [
            "proof",
            "witness",
            "counterexample",
            "derivation",
            "model",
            "trace",
            "bound"
          ]
        },
        "format_id": {"$ref": "#/$defs/namespaced"},
        "version": {
          "type": "string",
          "minLength": 5,
          "maxLength": 64,
          "pattern": "^1\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "major": {"const": 1},
        "minor": {"$ref": "#/$defs/quantity"},
        "reader_minimum_minor": {"$ref": "#/$defs/quantity"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "canonicalization": {"$ref": "#/$defs/namespaced"},
        "features": {"$ref": "#/$defs/namespaced_set"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "role",
        "name",
        "version",
        "contract_id",
        "contract_sha256",
        "implementation_sha256",
        "configuration_sha256",
        "environment_contract_sha256"
      ],
      "properties": {
        "component_id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["producer", "solver", "heuristic", "external"]},
        "name": {"$ref": "#/$defs/namespaced"},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "contract_id": {"$ref": "#/$defs/contract_id"},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "environment_contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_id",
        "role",
        "media_type",
        "sha256",
        "byte_count",
        "encoding",
        "compression",
        "extensions"
      ],
      "properties": {
        "payload_id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["primary", "auxiliary"]},
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"$ref": "#/$defs/quantity"},
        "encoding": {"enum": ["binary", "utf-8"]},
        "compression": {"enum": ["none", "gzip", "zstd"]},
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_sha256",
        "relation",
        "depends_on_evidence_ids"
      ],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/id"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "relation": {"enum": ["premise", "derivation", "input", "support"]},
        "depends_on_evidence_ids": {"$ref": "#/$defs/id_set"}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "seed",
        "algorithm_id",
        "configuration_sha256",
        "input_sha256",
        "basis_sha256"
      ],
      "properties": {
        "mode": {"enum": ["deterministic", "seeded"]},
        "seed": {
          "anyOf": [
            {"$ref": "#/$defs/quantity"},
            {"type": "null"}
          ]
        },
        "algorithm_id": {"$ref": "#/$defs/namespaced"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "basis_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_sha256", "final_sha256", "outcome"],
      "properties": {
        "initial_sha256": {"$ref": "#/$defs/sha256"},
        "final_sha256": {"$ref": "#/$defs/sha256"},
        "outcome": {"enum": ["completed", "cancelled", "exhausted", "truncated"]}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnostic_id", "severity", "code", "message", "related_payload_ids", "details"],
      "properties": {
        "diagnostic_id": {"$ref": "#/$defs/id"},
        "severity": {"enum": ["info", "warning", "error"]},
        "code": {"$ref": "#/$defs/namespaced"},
        "message": {"$ref": "#/$defs/reason"},
        "related_payload_ids": {"$ref": "#/$defs/id_set"},
        "details": {"$ref": "#/$defs/canonical_value"}
      }
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "payload_ids", "diagnostic_ids"],
          "properties": {
            "status": {"const": "produced"},
            "payload_ids": {"$ref": "#/$defs/id_set"},
            "diagnostic_ids": {"$ref": "#/$defs/id_set"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "unsupported_features", "reason", "diagnostic_ids"],
          "properties": {
            "status": {"const": "unsupported"},
            "unsupported_features": {"$ref": "#/$defs/namespaced_set"},
            "reason": {"$ref": "#/$defs/reason"},
            "diagnostic_ids": {"$ref": "#/$defs/id_set"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason", "diagnostic_ids"],
          "properties": {
            "status": {"const": "incomplete"},
            "reason": {"$ref": "#/$defs/reason"},
            "diagnostic_ids": {"$ref": "#/$defs/id_set"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "cancellation_id", "reason", "diagnostic_ids"],
          "properties": {
            "status": {"const": "cancelled"},
            "cancellation_id": {"$ref": "#/$defs/id"},
            "reason": {"$ref": "#/$defs/reason"},
            "diagnostic_ids": {"$ref": "#/$defs/id_set"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "dimensions", "reason", "diagnostic_ids"],
          "properties": {
            "status": {"const": "exhausted"},
            "dimensions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "wall_time_us",
                  "cpu_time_us",
                  "memory_bytes",
                  "solver_calls",
                  "generated_objects",
                  "proof_bytes",
                  "evidence_bytes",
                  "output_bytes",
                  "diagnostic_bytes",
                  "nesting_depth"
                ]
              }
            },
            "reason": {"$ref": "#/$defs/reason"},
            "diagnostic_ids": {"$ref": "#/$defs/id_set"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "truncation_ids", "retained_payload_ids", "reason", "diagnostic_ids"],
          "properties": {
            "status": {"const": "truncated"},
            "truncation_ids": {
              "allOf": [
                {"$ref": "#/$defs/id_set"},
                {"minItems": 1}
              ]
            },
            "retained_payload_ids": {"$ref": "#/$defs/id_set"},
            "reason": {"$ref": "#/$defs/reason"},
            "diagnostic_ids": {"$ref": "#/$defs/id_set"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "error_code", "reason", "diagnostic_ids"],
          "properties": {
            "status": {"const": "error"},
            "error_code": {"$ref": "#/$defs/namespaced"},
            "reason": {"$ref": "#/$defs/reason"},
            "diagnostic_ids": {"$ref": "#/$defs/id_set"}
          }
        }
      ]
    }
  }
}

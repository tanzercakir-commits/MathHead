{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/isolated-worker-request-v1.schema.json",
  "title": "MathHead Isolated Worker Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "planning_result_sha256", "strategy_sha256", "descriptor_sha256", "family", "protocol", "executable_sha256", "arguments", "artifact_bindings", "parent_budget_sha256", "lease_id", "child_budget_id", "resource_limits", "request_sha256", "mathematical_authority"],
  "properties": {
    "schema": {"const": "mathhead.isolated-worker-request.v1"},
    "planning_result_sha256": {"$ref": "#/$defs/sha256"},
    "strategy_sha256": {"$ref": "#/$defs/sha256"},
    "descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "family": {"enum": ["sympy", "python_enumeration", "smt", "external_process"]},
    "protocol": {"enum": ["raw_stdout_v1"]},
    "executable_sha256": {"$ref": "#/$defs/sha256"},
    "arguments": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "artifact_bindings": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/artifact_binding"}},
    "parent_budget_sha256": {"$ref": "#/$defs/sha256"},
    "lease_id": {"$ref": "#/$defs/id"},
    "child_budget_id": {"$ref": "#/$defs/id"},
    "resource_limits": {"$ref": "#/$defs/resource_vector"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "mathematical_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$"},
    "quantity": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "artifact_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "sha256", "bytes"],
      "properties": {
        "role": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"$ref": "#/$defs/quantity"}
      }
    },
    "resource_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_us", "cpu_time_us", "memory_bytes", "solver_calls", "generated_objects", "proof_bytes", "evidence_bytes", "output_bytes", "diagnostic_bytes", "nesting_depth"],
      "properties": {
        "wall_time_us": {"$ref": "#/$defs/quantity"}, "cpu_time_us": {"$ref": "#/$defs/quantity"}, "memory_bytes": {"$ref": "#/$defs/quantity"}, "solver_calls": {"$ref": "#/$defs/quantity"}, "generated_objects": {"$ref": "#/$defs/quantity"}, "proof_bytes": {"$ref": "#/$defs/quantity"}, "evidence_bytes": {"$ref": "#/$defs/quantity"}, "output_bytes": {"$ref": "#/$defs/quantity"}, "diagnostic_bytes": {"$ref": "#/$defs/quantity"}, "nesting_depth": {"$ref": "#/$defs/quantity"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/isolated-worker-result-v1.schema.json",
  "title": "MathHead Isolated Worker Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_id", "contract_sha256", "resource_budget_contract_sha256", "deterministic_planner_contract_sha256", "status", "reason_code", "request_sha256", "planning_result_sha256", "strategy_sha256", "capability", "usage", "artifacts", "diagnostics", "child_budget_sha256", "parent_budget_sha256", "tree_terminated", "lease_reconciled", "semantic_sha256", "result_sha256", "mathematical_authority"],
  "properties": {
    "schema": {"const": "mathhead.isolated-worker-result.v1"},
    "contract_id": {"const": "MH-C-ISOLATED-WORKER-001"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "resource_budget_contract_sha256": {"$ref": "#/$defs/sha256"},
    "deterministic_planner_contract_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["completed", "refused", "unsupported", "exhausted", "cancelled", "failed", "invalid"]},
    "reason_code": {"enum": ["COMPLETED", "REQUEST_INVALID", "PLAN_INVALID", "STRATEGY_MISMATCH", "BUDGET_INVALID", "BUDGET_INSUFFICIENT", "ISOLATION_UNSUPPORTED", "EXECUTABLE_INVALID", "LAUNCH_FAILED", "WALL_TIME_EXHAUSTED", "CPU_TIME_EXHAUSTED", "MEMORY_EXHAUSTED", "OUTPUT_EXHAUSTED", "DIAGNOSTIC_EXHAUSTED", "CANCELLED", "EXIT_FAILED", "PROTOCOL_FAILED", "TREE_CLEANUP_FAILED", "SUPERVISOR_FAILED"]},
    "request_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "planning_result_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "strategy_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "capability": {"anyOf": [{"type": "null"}, {"$ref": "isolation-capability-v1.schema.json"}]},
    "usage": {"anyOf": [{"type": "null"}, {"$ref": "worker-resource-usage-v1.schema.json"}]},
    "artifacts": {"type": "array", "maxItems": 2, "items": {"$ref": "worker-artifact-v1.schema.json"}},
    "diagnostics": {"type": "array", "maxItems": 32, "items": {"$ref": "worker-diagnostic-v1.schema.json"}},
    "child_budget_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "parent_budget_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "tree_terminated": {"type": "boolean"},
    "lease_reconciled": {"type": "boolean"},
    "semantic_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "result_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "mathematical_authority": {"const": false}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/planning-evidence-expectation-v1.schema.json",
  "title": "MathHead Planning Evidence Expectation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation_authority", "producer_component_id", "checker_component_id", "evidence_contract_sha256", "certificate_contract_sha256", "evidence_format", "certificate_format", "independent_check_required", "expectation_sha256", "mathematical_authority"],
  "properties": {
    "schema": {"const": "mathhead.planning-evidence-expectation.v1"},
    "operation_authority": {"enum": ["none", "producer_report", "checker_attestation"]},
    "producer_component_id": {"$ref": "#/$defs/id"},
    "checker_component_id": {"$ref": "#/$defs/id"},
    "evidence_contract_sha256": {"$ref": "#/$defs/sha256"},
    "certificate_contract_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_format": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/format"}]},
    "certificate_format": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/format"}]},
    "independent_check_required": {"type": "boolean"},
    "expectation_sha256": {"$ref": "#/$defs/sha256"},
    "mathematical_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$"},
    "namespaced": {"type": "string", "minLength": 3, "maxLength": 255, "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"},
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format_id", "major", "minor", "required_features"],
      "properties": {
        "format_id": {"$ref": "#/$defs/namespaced"},
        "major": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "minor": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "required_features": {"type": "array", "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/namespaced"}}
      }
    }
  }
}

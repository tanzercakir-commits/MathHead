{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/planning-request-v1.schema.json",
  "title": "MathHead Planning Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "route_request", "route_result_sha256", "resource_budget_contract_sha256", "resource_limits", "policy", "request_sha256", "mathematical_authority"],
  "properties": {
    "schema": {"const": "mathhead.planning-request.v1"},
    "route_request": {"type": "object"},
    "route_result_sha256": {"$ref": "#/$defs/sha256"},
    "resource_budget_contract_sha256": {"$ref": "#/$defs/sha256"},
    "resource_limits": {"$ref": "#/$defs/resource_vector"},
    "policy": {"type": "object"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "mathematical_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "quantity": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "resource_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_us", "cpu_time_us", "memory_bytes", "solver_calls", "generated_objects", "proof_bytes", "evidence_bytes", "output_bytes", "diagnostic_bytes", "nesting_depth"],
      "properties": {
        "wall_time_us": {"$ref": "#/$defs/quantity"},
        "cpu_time_us": {"$ref": "#/$defs/quantity"},
        "memory_bytes": {"$ref": "#/$defs/quantity"},
        "solver_calls": {"$ref": "#/$defs/quantity"},
        "generated_objects": {"$ref": "#/$defs/quantity"},
        "proof_bytes": {"$ref": "#/$defs/quantity"},
        "evidence_bytes": {"$ref": "#/$defs/quantity"},
        "output_bytes": {"$ref": "#/$defs/quantity"},
        "diagnostic_bytes": {"$ref": "#/$defs/quantity"},
        "nesting_depth": {"$ref": "#/$defs/quantity"}
      }
    }
  }
}

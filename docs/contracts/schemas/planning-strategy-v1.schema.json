{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/planning-strategy-v1.schema.json",
  "title": "MathHead Planning Strategy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_order", "route_order", "candidate_sha256", "descriptor_sha256", "plugin_id", "plugin_version", "capability_id", "capability_kind", "operation", "component_id", "producer_component_id", "checker_component_id", "session_head_sha256", "session_context_sha256", "normalization_result_sha256", "obligation_semantic_sha256", "fragment_sha256", "dependency_descriptor_sha256s", "effect_kinds", "replay_mode", "priority", "estimated_cost", "cost_sha256", "prerequisites", "evidence_expectation", "resource_request", "transitions", "strategy_sha256", "mathematical_authority"],
  "properties": {
    "schema": {"const": "mathhead.planning-strategy.v1"},
    "plan_order": {"type": "integer", "minimum": 0, "maximum": 99999},
    "route_order": {"type": "integer", "minimum": 0, "maximum": 999999},
    "candidate_sha256": {"$ref": "#/$defs/sha256"}, "descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "plugin_id": {"$ref": "#/$defs/namespaced"}, "plugin_version": {"$ref": "#/$defs/semver"}, "capability_id": {"$ref": "#/$defs/id"},
    "capability_kind": {"enum": ["construction", "decision", "explanation", "verification"]}, "operation": {"enum": ["plan_cost", "solve", "check", "explain"]},
    "component_id": {"$ref": "#/$defs/id"}, "producer_component_id": {"$ref": "#/$defs/id"}, "checker_component_id": {"$ref": "#/$defs/id"},
    "session_head_sha256": {"$ref": "#/$defs/sha256"}, "session_context_sha256": {"$ref": "#/$defs/sha256"}, "normalization_result_sha256": {"$ref": "#/$defs/sha256"}, "obligation_semantic_sha256": {"$ref": "#/$defs/sha256"}, "fragment_sha256": {"$ref": "#/$defs/sha256"},
    "dependency_descriptor_sha256s": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "effect_kinds": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"enum": ["environment", "filesystem", "network", "process", "solver"]}},
    "replay_mode": {"enum": ["deterministic", "seeded", "recorded"]},
    "priority": {"$ref": "#/$defs/quantity"}, "estimated_cost": {"$ref": "#/$defs/quantity"}, "cost_sha256": {"$ref": "#/$defs/sha256"},
    "prerequisites": {"type": "array", "minItems": 6, "maxItems": 10020, "items": {"type": "object"}},
    "evidence_expectation": {"type": "object"}, "resource_request": {"type": "object"},
    "transitions": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"type": "object"}},
    "strategy_sha256": {"$ref": "#/$defs/sha256"}, "mathematical_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "quantity": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$"}, "namespaced": {"type": "string", "minLength": 3, "maxLength": 255, "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"}, "semver": {"type": "string", "minLength": 5, "maxLength": 64, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}
  }
}

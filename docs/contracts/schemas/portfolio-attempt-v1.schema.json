{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/portfolio-attempt-v1.schema.json",
  "title": "MathHead Portfolio Attempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attempt_order",
    "strategy_sha256",
    "producer_worker_result_sha256",
    "producer_status",
    "producer_reason_code",
    "evidence_sha256",
    "evidence_bytes",
    "checker_worker_result_sha256",
    "checker_status",
    "checker_reason_code",
    "checker_decision_sha256",
    "outcome",
    "transition_sha256",
    "parent_budget_before_sha256",
    "parent_budget_after_sha256",
    "attempt_sha256",
    "mathematical_authority"
  ],
  "properties": {
    "schema": {"const": "mathhead.portfolio-attempt.v1"},
    "attempt_order": {"$ref": "#/$defs/quantity"},
    "strategy_sha256": {"$ref": "#/$defs/sha256"},
    "producer_worker_result_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "producer_status": {"enum": ["not_started", "completed", "refused", "unsupported", "exhausted", "cancelled", "failed", "invalid"]},
    "producer_reason_code": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Z][A-Z0-9_]*$"},
    "evidence_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "evidence_bytes": {"$ref": "#/$defs/quantity"},
    "checker_worker_result_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "checker_status": {"enum": ["not_started", "completed", "refused", "unsupported", "exhausted", "cancelled", "failed", "invalid"]},
    "checker_reason_code": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Z][A-Z0-9_]*$"},
    "checker_decision_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "outcome": {"enum": ["success", "unsupported", "exhausted", "cancelled", "producer_error", "ambiguous", "truncated", "checker_inconclusive", "checker_disagreement", "verifier_failure", "invalid_evidence"]},
    "transition_sha256": {"$ref": "#/$defs/sha256"},
    "parent_budget_before_sha256": {"$ref": "#/$defs/sha256"},
    "parent_budget_after_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_sha256": {"$ref": "#/$defs/sha256"},
    "mathematical_authority": {"const": false}
  },
  "$defs": {
    "quantity": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
  }
}

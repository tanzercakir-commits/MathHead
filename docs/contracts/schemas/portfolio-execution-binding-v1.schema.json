{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/portfolio-execution-binding-v1.schema.json",
  "title": "MathHead Portfolio Execution Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_order",
    "strategy_sha256",
    "descriptor_sha256",
    "producer_component_id",
    "checker_component_id",
    "producer_family",
    "checker_family",
    "producer_executable_sha256",
    "checker_executable_sha256",
    "producer_arguments",
    "checker_arguments",
    "input_artifacts",
    "protocol",
    "binding_sha256",
    "mathematical_authority"
  ],
  "properties": {
    "schema": {"const": "mathhead.portfolio-execution-binding.v1"},
    "plan_order": {"$ref": "#/$defs/quantity"},
    "strategy_sha256": {"$ref": "#/$defs/sha256"},
    "descriptor_sha256": {"$ref": "#/$defs/sha256"},
    "producer_component_id": {"$ref": "#/$defs/id"},
    "checker_component_id": {"$ref": "#/$defs/id"},
    "producer_family": {"$ref": "#/$defs/family"},
    "checker_family": {"$ref": "#/$defs/family"},
    "producer_executable_sha256": {"$ref": "#/$defs/sha256"},
    "checker_executable_sha256": {"$ref": "#/$defs/sha256"},
    "producer_arguments": {"$ref": "#/$defs/arguments"},
    "checker_arguments": {"$ref": "#/$defs/arguments"},
    "input_artifacts": {
      "type": "array",
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/artifact_binding"}
    },
    "protocol": {"const": "canonical_evidence_certificate_v1"},
    "binding_sha256": {"$ref": "#/$defs/sha256"},
    "mathematical_authority": {"const": false}
  },
  "$defs": {
    "quantity": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$"},
    "family": {"enum": ["sympy", "enumeration", "smt", "external"]},
    "argument": {"type": "string", "maxLength": 1048576},
    "arguments": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/argument"}},
    "artifact_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "sha256", "bytes"],
      "properties": {
        "role": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"$ref": "#/$defs/quantity"}
      }
    }
  }
}

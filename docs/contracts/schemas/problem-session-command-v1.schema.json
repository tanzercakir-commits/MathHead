{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/problem-session-command-v1.schema.json",
  "title": "MathHead problem-session command v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "mathhead.problem-session-command.v1"},
    "command_id": {"$ref": "#/$defs/id"},
    "kind": {
      "enum": [
        "create_session",
        "replace_context",
        "put_definition",
        "put_lemma",
        "put_attempt",
        "put_obligation",
        "retire_record"
      ]
    },
    "session_id": {"$ref": "#/$defs/id"},
    "expected_head_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "context_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "analysis_artifact_sha256s": {"$ref": "#/$defs/digests"},
    "introduced_artifacts": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "problem-session-artifact-link-v1.schema.json"}
    },
    "record": {
      "anyOf": [
        {"$ref": "problem-session-definition-v1.schema.json"},
        {"$ref": "problem-session-lemma-v1.schema.json"},
        {"$ref": "problem-session-attempt-v1.schema.json"},
        {"$ref": "problem-session-obligation-state-v1.schema.json"},
        {"type": "null"}
      ]
    },
    "target_record_kind": {
      "enum": ["definition", "lemma", "attempt", "obligation", null]
    },
    "target_record_id": {
      "anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
    },
    "reason_code": {
      "anyOf": [
        {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
        {"type": "null"}
      ]
    },
    "command_sha256": {"$ref": "#/$defs/sha256"}
  },
  "required": [
    "schema",
    "command_id",
    "kind",
    "session_id",
    "expected_head_sha256",
    "context_sha256",
    "analysis_artifact_sha256s",
    "introduced_artifacts",
    "record",
    "target_record_kind",
    "target_record_id",
    "reason_code",
    "command_sha256"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "digests": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "create_session"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "expected_head_sha256": {"type": "null"},
          "context_sha256": {"$ref": "#/$defs/sha256"},
          "analysis_artifact_sha256s": {"minItems": 1},
          "record": {"type": "null"},
          "target_record_kind": {"type": "null"},
          "target_record_id": {"type": "null"},
          "reason_code": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "replace_context"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "expected_head_sha256": {"$ref": "#/$defs/sha256"},
          "context_sha256": {"$ref": "#/$defs/sha256"},
          "analysis_artifact_sha256s": {"minItems": 1},
          "record": {"type": "null"},
          "target_record_kind": {"type": "null"},
          "target_record_id": {"type": "null"},
          "reason_code": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {"enum": ["put_definition", "put_lemma", "put_attempt", "put_obligation"]}
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "expected_head_sha256": {"$ref": "#/$defs/sha256"},
          "context_sha256": {"type": "null"},
          "analysis_artifact_sha256s": {"maxItems": 0},
          "record": {"not": {"type": "null"}},
          "target_record_kind": {"type": "null"},
          "target_record_id": {"type": "null"},
          "reason_code": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "retire_record"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "expected_head_sha256": {"$ref": "#/$defs/sha256"},
          "context_sha256": {"type": "null"},
          "analysis_artifact_sha256s": {"maxItems": 0},
          "introduced_artifacts": {"maxItems": 0},
          "record": {"type": "null"},
          "target_record_kind": {"not": {"type": "null"}},
          "target_record_id": {"$ref": "#/$defs/id"},
          "reason_code": {"type": "string"}
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/problem-session-event-v1.schema.json",
  "title": "MathHead problem-session event v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "mathhead.problem-session-event.v1"},
    "session_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "parent_event_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "command": {"$ref": "problem-session-command-v1.schema.json"},
    "command_sha256": {"$ref": "#/$defs/sha256"},
    "introduced_artifact_sha256s": {"$ref": "#/$defs/digests"},
    "invalidations": {
      "type": "array",
      "maxItems": 1000000,
      "items": {"$ref": "problem-session-invalidation-v1.schema.json"}
    },
    "view_sha256": {"$ref": "#/$defs/sha256"},
    "event_sha256": {"$ref": "#/$defs/sha256"},
    "mathematical_authority": {"const": false}
  },
  "required": [
    "schema",
    "session_id",
    "revision",
    "parent_event_sha256",
    "command",
    "command_sha256",
    "introduced_artifact_sha256s",
    "invalidations",
    "view_sha256",
    "event_sha256",
    "mathematical_authority"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digests": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/problem-session-lemma-v1.schema.json",
  "title": "MathHead problem-session lemma record v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "mathhead.problem-session-lemma.v1"},
    "record_id": {"$ref": "#/$defs/id"},
    "generation": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "lemma_id": {"$ref": "#/$defs/id"},
    "statement_sha256": {"$ref": "#/$defs/sha256"},
    "primary_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "context_sha256": {"$ref": "#/$defs/sha256"},
    "reading_id": {
      "anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
    },
    "evidence_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "certificate_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "provenance_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "retained_tier": {
      "enum": ["unchecked", "checker_attestation", "external_proof_assistant"]
    },
    "depends_on_record_sha256s": {"$ref": "#/$defs/dependencies"},
    "record_sha256": {"$ref": "#/$defs/sha256"},
    "mathematical_authority": {"const": false}
  },
  "required": [
    "schema",
    "record_id",
    "generation",
    "lemma_id",
    "statement_sha256",
    "primary_artifact_sha256",
    "context_sha256",
    "reading_id",
    "evidence_sha256",
    "certificate_sha256",
    "provenance_sha256",
    "retained_tier",
    "depends_on_record_sha256s",
    "record_sha256",
    "mathematical_authority"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "dependencies": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    }
  }
}

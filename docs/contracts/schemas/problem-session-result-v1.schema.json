{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/problem-session-result-v1.schema.json",
  "title": "MathHead problem-session transition result v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "mathhead.problem-session-result.v1"},
    "contract_id": {"const": "MH-C-PROBLEM-SESSION-001"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["updated", "unchanged", "conflict", "invalid", "exhausted"]},
    "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
    "diagnostic": {"type": "string", "maxLength": 512},
    "session_id": {
      "anyOf": [
        {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        {"type": "null"}
      ]
    },
    "revision": {
      "anyOf": [
        {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        {"type": "null"}
      ]
    },
    "head_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "view_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "event_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "artifact_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "stale_record_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "revision_value": {
      "anyOf": [
        {"$ref": "problem-session-revision-v1.schema.json"},
        {"type": "null"}
      ]
    },
    "result_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "mathematical_authority": {"const": false}
  },
  "required": [
    "schema",
    "contract_id",
    "contract_sha256",
    "status",
    "reason_code",
    "diagnostic",
    "session_id",
    "revision",
    "head_sha256",
    "view_sha256",
    "event_count",
    "artifact_count",
    "stale_record_count",
    "revision_value",
    "result_sha256",
    "mathematical_authority"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/problem-session-revision-v1.schema.json",
  "title": "MathHead problem-session revision v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "mathhead.problem-session-revision.v1"},
    "session_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "parent_event_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "head_event_sha256": {"$ref": "#/$defs/sha256"},
    "context_sha256": {"$ref": "#/$defs/sha256"},
    "analysis_artifact_sha256s": {"$ref": "#/$defs/digests"},
    "definitions": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "problem-session-definition-v1.schema.json"}
    },
    "lemmas": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "problem-session-lemma-v1.schema.json"}
    },
    "attempts": {
      "type": "array",
      "maxItems": 1000000,
      "items": {"$ref": "problem-session-attempt-v1.schema.json"}
    },
    "obligations": {
      "type": "array",
      "maxItems": 1000000,
      "items": {"$ref": "problem-session-obligation-state-v1.schema.json"}
    },
    "stale_record_sha256s": {"$ref": "#/$defs/large_digests"},
    "retired_record_sha256s": {"$ref": "#/$defs/large_digests"},
    "invalidation_sha256s": {"$ref": "#/$defs/large_digests"},
    "event_sha256s": {"$ref": "#/$defs/large_digests"},
    "artifact_sha256s": {"$ref": "#/$defs/large_digests"},
    "view_sha256": {"$ref": "#/$defs/sha256"},
    "revision_sha256": {"$ref": "#/$defs/sha256"},
    "mathematical_authority": {"const": false}
  },
  "required": [
    "schema",
    "session_id",
    "revision",
    "parent_event_sha256",
    "head_event_sha256",
    "context_sha256",
    "analysis_artifact_sha256s",
    "definitions",
    "lemmas",
    "attempts",
    "obligations",
    "stale_record_sha256s",
    "retired_record_sha256s",
    "invalidation_sha256s",
    "event_sha256s",
    "artifact_sha256s",
    "view_sha256",
    "revision_sha256",
    "mathematical_authority"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digests": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "large_digests": {
      "type": "array",
      "maxItems": 1000000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    }
  }
}

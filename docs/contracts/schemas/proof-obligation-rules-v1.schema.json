{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/proof-obligation-rules-v1.schema.json",
  "title": "MathHead proof-obligation decomposition rule catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "mathhead.proof-obligation-rules.v1"},
    "catalogue_id": {"const": "mathhead.proof-obligation-rules.v1"},
    "policy": {"const": "syntax-directed decomposition only; no solving, semantic normalization, or truth claim"},
    "rules": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/rule"}},
    "mathematical_authority": {"const": false}
  },
  "required": ["schema", "catalogue_id", "policy", "rules", "mathematical_authority"],
  "$defs": {
    "rule": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "rule_id": {"type": "string", "pattern": "^mh[.]obligation[.][a-z0-9_.-]+$", "maxLength": 160},
        "goal_mode": {"enum": ["any", "prove", "refute", "find_witness", "compute", "classify", "optimize"]},
        "statement_match": {"type": "string", "minLength": 1, "maxLength": 128},
        "obligation_kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "supported": {"type": "boolean"},
        "description": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "required": ["rule_id", "goal_mode", "statement_match", "obligation_kind", "supported", "description"]
    }
  }
}

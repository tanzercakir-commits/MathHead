{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/proof-search-portfolio-result-v1.schema.json",
  "title": "MathHead Proof Search Portfolio Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_id",
    "contract_sha256",
    "deterministic_planner_contract_sha256",
    "isolated_worker_contract_sha256",
    "resource_budget_contract_sha256",
    "engine_result_contract_sha256",
    "evidence_contract_sha256",
    "certificate_contract_sha256",
    "theory_plugin_contract_sha256",
    "capability_registry_contract_sha256",
    "trust_transition_contract_sha256",
    "status",
    "mathematical_verdict",
    "reason_code",
    "request_sha256",
    "planning_result_sha256",
    "initial_parent_budget_sha256",
    "final_parent_budget_sha256",
    "preference_policy",
    "attempts",
    "inconclusive_outcomes",
    "selected_strategy_sha256",
    "selected_evidence_sha256",
    "selected_certificate_sha256",
    "selected_checker_decision_sha256",
    "authority_tier",
    "result_sha256",
    "mathematical_authority"
  ],
  "properties": {
    "schema": {"const": "mathhead.proof-search-portfolio-result.v1"},
    "contract_id": {"const": "MH-C-PROOF-SEARCH-PORTFOLIO-001"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "deterministic_planner_contract_sha256": {"$ref": "#/$defs/sha256"},
    "isolated_worker_contract_sha256": {"$ref": "#/$defs/sha256"},
    "resource_budget_contract_sha256": {"$ref": "#/$defs/sha256"},
    "engine_result_contract_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_contract_sha256": {"$ref": "#/$defs/sha256"},
    "certificate_contract_sha256": {"$ref": "#/$defs/sha256"},
    "theory_plugin_contract_sha256": {"$ref": "#/$defs/sha256"},
    "capability_registry_contract_sha256": {"$ref": "#/$defs/sha256"},
    "trust_transition_contract_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["succeeded", "unsupported", "exhausted", "cancelled", "failed", "ambiguous", "truncated", "inconclusive", "disagreement", "verifier_failed", "invalid_evidence", "invalid"]},
    "mathematical_verdict": {"enum": ["proved", "refuted", "inconclusive", "none"]},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Z][A-Z0-9_]*$"},
    "request_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "planning_result_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "initial_parent_budget_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "final_parent_budget_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "preference_policy": {"const": "planner_order_no_sound_witness_declaration"},
    "attempts": {"type": "array", "maxItems": 100000, "items": {"$ref": "portfolio-attempt-v1.schema.json"}},
    "inconclusive_outcomes": {"type": "array", "maxItems": 100000, "items": {"$ref": "portfolio-inconclusive-v1.schema.json"}},
    "selected_strategy_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "selected_evidence_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "selected_certificate_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "selected_checker_decision_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "authority_tier": {"enum": ["none", "checker_attestation", "external_proof_assistant"]},
    "result_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "mathematical_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
  }
}

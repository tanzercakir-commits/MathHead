{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/proof-strategy-catalogue-v1.schema.json",
  "title": "MathHead proof strategy admissibility catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "mathhead.proof-strategy-catalogue.v1"},
    "catalogue_id": {"const": "mathhead.proof-strategy-catalogue.v1"},
    "policy": {"const": "exact structural admissibility hints only; no ranking, execution, success, or authority claim"},
    "strategies": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/strategy"}},
    "guarantees_success": {"const": false},
    "mathematical_authority": {"const": false}
  },
  "required": ["schema", "catalogue_id", "policy", "strategies", "guarantees_success", "mathematical_authority"],
  "$defs": {
    "strategy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "strategy_id": {"type": "string", "pattern": "^mh[.]strategy[.][a-z0-9_.-]+$", "maxLength": 160},
        "match_rule_id": {"type": "string", "pattern": "^mh[.]strategy-match[.][a-z0-9_.-]+$", "maxLength": 160},
        "match_axis": {"enum": ["obligation_kind", "goal_mode", "relation_kind", "domain_kind", "builtin_carrier"]},
        "match_values": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 255}},
        "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 128},
        "description": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "required": ["strategy_id", "match_rule_id", "match_axis", "match_values", "reason_code", "description"]
    }
  }
}

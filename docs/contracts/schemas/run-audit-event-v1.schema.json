{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/run-audit-event-v1.schema.json",
  "title": "MathHead Run Audit Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_order",
    "kind",
    "attempt_order",
    "strategy_sha256",
    "phase",
    "outcome",
    "reason_code",
    "subject_sha256s",
    "parent_budget_before_sha256",
    "parent_budget_after_sha256",
    "previous_event_sha256",
    "event_sha256",
    "mathematical_authority"
  ],
  "properties": {
    "schema": {"const": "mathhead.run-audit-event.v1"},
    "event_order": {"$ref": "#/$defs/quantity"},
    "kind": {
      "enum": [
        "run_opened",
        "input_bound",
        "plan_bound",
        "strategy_started",
        "producer_completed",
        "evidence_classified",
        "checker_completed",
        "checker_decided",
        "transition_selected",
        "run_closed"
      ]
    },
    "attempt_order": {"$ref": "#/$defs/nullable_quantity"},
    "strategy_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "phase": {"enum": ["run", "input", "plan", "producer", "checker", "transition"]},
    "outcome": {
      "enum": [
        "opened",
        "bound",
        "completed",
        "not_started",
        "success",
        "unsupported",
        "producer_error",
        "ambiguous",
        "cancelled",
        "exhausted",
        "truncated",
        "invalid_evidence",
        "checker_inconclusive",
        "checker_disagreement",
        "verifier_failure",
        "failed",
        "invalid",
        "closed"
      ]
    },
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Z][A-Z0-9_]*$"},
    "subject_sha256s": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "parent_budget_before_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "parent_budget_after_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "previous_event_sha256": {"$ref": "#/$defs/nullable_sha256"},
    "event_sha256": {"$ref": "#/$defs/sha256"},
    "mathematical_authority": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "quantity": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "nullable_quantity": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/quantity"}]}
  }
}

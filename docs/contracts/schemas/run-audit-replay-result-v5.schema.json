{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/run-audit-replay-result-v5.schema.json",
  "title": "MathHead Run Audit Replay Result v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_id",
    "contract_sha256",
    "status",
    "reason_code",
    "manifest_sha256",
    "bundle_sha256",
    "logical_report_sha256",
    "execution_provenance_sha256",
    "object_count",
    "event_count",
    "portfolio_status",
    "mathematical_verdict",
    "authority_tier",
    "replay_result_sha256",
    "mathematical_authority"
  ],
  "properties": {
    "schema": {
      "const": "mathhead.run-audit-replay-result.v5"
    },
    "contract_id": {
      "const": "MH-C-RUN-AUDIT-REPLAY-005"
    },
    "contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "enum": [
        "complete",
        "invalid",
        "exhausted"
      ]
    },
    "reason_code": {
      "enum": [
        "REPLAY_COMPLETE",
        "REPLAY_INVALID",
        "REPLAY_BUDGET_EXHAUSTED"
      ]
    },
    "manifest_sha256": {
      "$ref": "#/$defs/nullable_sha256"
    },
    "bundle_sha256": {
      "$ref": "#/$defs/nullable_sha256"
    },
    "logical_report_sha256": {
      "$ref": "#/$defs/nullable_sha256"
    },
    "object_count": {
      "$ref": "#/$defs/quantity"
    },
    "event_count": {
      "$ref": "#/$defs/quantity"
    },
    "portfolio_status": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "succeeded",
            "unsupported",
            "exhausted",
            "cancelled",
            "failed",
            "ambiguous",
            "truncated",
            "inconclusive",
            "disagreement",
            "verifier_failed",
            "invalid_evidence",
            "invalid"
          ]
        }
      ]
    },
    "mathematical_verdict": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "proved",
            "refuted",
            "inconclusive",
            "none"
          ]
        }
      ]
    },
    "authority_tier": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "none",
            "checker_attestation",
            "external_proof_assistant"
          ]
        }
      ]
    },
    "replay_result_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "mathematical_authority": {
      "const": false
    },
    "execution_provenance_sha256": {
      "$ref": "#/$defs/nullable_sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "quantity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "complete"
            },
            "reason_code": {
              "const": "REPLAY_COMPLETE"
            },
            "manifest_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "bundle_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "logical_report_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "execution_provenance_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "portfolio_status": {
              "enum": [
                "succeeded",
                "unsupported",
                "exhausted",
                "cancelled",
                "failed",
                "ambiguous",
                "truncated",
                "inconclusive",
                "disagreement",
                "verifier_failed",
                "invalid_evidence",
                "invalid"
              ]
            },
            "mathematical_verdict": {
              "enum": [
                "proved",
                "refuted",
                "inconclusive",
                "none"
              ]
            },
            "authority_tier": {
              "enum": [
                "none",
                "checker_attestation",
                "external_proof_assistant"
              ]
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "invalid"
            },
            "reason_code": {
              "const": "REPLAY_INVALID"
            },
            "manifest_sha256": {
              "type": "null"
            },
            "bundle_sha256": {
              "type": "null"
            },
            "logical_report_sha256": {
              "type": "null"
            },
            "execution_provenance_sha256": {
              "type": "null"
            },
            "event_count": {
              "const": 0
            },
            "portfolio_status": {
              "type": "null"
            },
            "mathematical_verdict": {
              "type": "null"
            },
            "authority_tier": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "exhausted"
            },
            "reason_code": {
              "const": "REPLAY_BUDGET_EXHAUSTED"
            },
            "manifest_sha256": {
              "type": "null"
            },
            "bundle_sha256": {
              "type": "null"
            },
            "logical_report_sha256": {
              "type": "null"
            },
            "execution_provenance_sha256": {
              "type": "null"
            },
            "event_count": {
              "const": 0
            },
            "portfolio_status": {
              "type": "null"
            },
            "mathematical_verdict": {
              "type": "null"
            },
            "authority_tier": {
              "type": "null"
            }
          }
        }
      ]
    }
  ]
}

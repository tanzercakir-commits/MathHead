{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/run-audit-store-record-v2.schema.json",
  "title": "MathHead Run Audit Store Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "store_contract_sha256",
    "manifest_sha256",
    "logical_report_sha256",
    "object_sha256s",
    "record_sha256",
    "mathematical_authority"
  ],
  "properties": {
    "schema": {
      "const": "mathhead.run-audit-store-record.v2"
    },
    "store_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "logical_report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "object_sha256s": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "record_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "mathematical_authority": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

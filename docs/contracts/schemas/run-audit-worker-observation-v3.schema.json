{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/run-audit-worker-observation-v3.schema.json",
  "title": "MathHead Run Audit Worker Observation v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attempt_order",
    "phase",
    "request_sha256",
    "result_identity_sha256",
    "result",
    "observation_sha256",
    "mathematical_authority"
  ],
  "properties": {
    "schema": {
      "const": "mathhead.run-audit-worker-observation.v3"
    },
    "attempt_order": {
      "$ref": "#/$defs/quantity"
    },
    "phase": {
      "enum": [
        "producer",
        "checker"
      ]
    },
    "request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "result_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "contract_id",
        "contract_sha256",
        "status",
        "reason_code",
        "planning_result_sha256",
        "strategy_sha256",
        "capability",
        "artifacts",
        "diagnostics",
        "tree_terminated",
        "lease_reconciled",
        "mathematical_authority"
      ],
      "properties": {
        "schema": {
          "const": "mathhead.isolated-worker-result.v1"
        },
        "contract_id": {
          "const": "MH-C-ISOLATED-WORKER-001"
        },
        "contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "completed",
            "refused",
            "unsupported",
            "exhausted",
            "cancelled",
            "failed",
            "invalid"
          ]
        },
        "reason_code": {
          "$ref": "#/$defs/reason"
        },
        "planning_result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "strategy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "capability": {
          "const": null
        },
        "artifacts": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 0
        },
        "tree_terminated": {
          "type": "boolean"
        },
        "lease_reconciled": {
          "type": "boolean"
        },
        "mathematical_authority": {
          "const": false
        }
      }
    },
    "observation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "mathematical_authority": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "quantity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "role",
        "media_type",
        "original_bytes",
        "retained_bytes",
        "omitted_bytes",
        "retained_sha256",
        "artifact_sha256",
        "mathematical_authority"
      ],
      "properties": {
        "schema": {
          "const": "mathhead.worker-artifact.v1"
        },
        "role": {
          "enum": [
            "stdout",
            "stderr"
          ]
        },
        "media_type": {
          "const": "application/octet-stream"
        },
        "original_bytes": {
          "$ref": "#/$defs/quantity"
        },
        "retained_bytes": {
          "$ref": "#/$defs/quantity"
        },
        "omitted_bytes": {
          "$ref": "#/$defs/quantity"
        },
        "retained_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mathematical_authority": {
          "const": false
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/theory-plugin-v1.schema.json",
  "title": "MathHead TheoryPlugin v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plugin_id",
    "display_name",
    "plugin_version",
    "api",
    "implementation",
    "components",
    "compatibility",
    "capabilities",
    "operations",
    "lifecycle",
    "effects",
    "replay",
    "limits",
    "extensions"
  ],
  "properties": {
    "schema": {"const": "mathhead.theory-plugin.v1"},
    "plugin_id": {"$ref": "#/$defs/namespaced"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "plugin_version": {"$ref": "#/$defs/semver"},
    "api": {"$ref": "#/$defs/api"},
    "implementation": {"$ref": "#/$defs/implementation"},
    "components": {"$ref": "#/$defs/components"},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/capability"}
    },
    "operations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/operation"}
    },
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "effects": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/effect"}
    },
    "replay": {"$ref": "#/$defs/replay"},
    "limits": {"$ref": "#/$defs/limits"},
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "integer": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "quantity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "namespaced": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semver": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 4096},
    "id_set": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "namespaced_set": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/namespaced"}
    },
    "contract_id_set": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/contract_id"}
    },
    "canonical_value": {
      "anyOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"$ref": "#/$defs/integer"},
        {"type": "string"},
        {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/canonical_value"}
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {"$ref": "#/$defs/canonical_value"}
        }
      ]
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/namespaced"},
      "additionalProperties": {"$ref": "#/$defs/canonical_value"}
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_sha256",
        "version",
        "major",
        "minor",
        "reader_minimum_minor"
      ],
      "properties": {
        "contract_id": {"const": "MH-C-THEORY-PLUGIN-001"},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "major": {"const": 1},
        "minor": {"$ref": "#/$defs/quantity"},
        "reader_minimum_minor": {"$ref": "#/$defs/quantity"}
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "package_version",
        "entry_point",
        "implementation_sha256",
        "configuration_sha256",
        "environment_contract_sha256"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "package_version": {"$ref": "#/$defs/semver"},
        "entry_point": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
        },
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "environment_contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "role",
        "name",
        "version",
        "contract_id",
        "contract_sha256",
        "implementation_sha256",
        "configuration_sha256"
      ],
      "properties": {
        "component_id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["producer", "checker"]},
        "name": {"$ref": "#/$defs/namespaced"},
        "version": {"$ref": "#/$defs/semver"},
        "contract_id": {"$ref": "#/$defs/contract_id"},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "checker"],
      "properties": {
        "producer": {"$ref": "#/$defs/component"},
        "checker": {"$ref": "#/$defs/component"}
      }
    },
    "contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "sha256", "schema"],
      "properties": {
        "contract_id": {"$ref": "#/$defs/contract_id"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema": {"$ref": "#/$defs/namespaced"}
      }
    },
    "plugin_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_id", "version_minimum", "version_maximum_exclusive", "descriptor_sha256"],
      "properties": {
        "plugin_id": {"$ref": "#/$defs/namespaced"},
        "version_minimum": {"$ref": "#/$defs/semver"},
        "version_maximum_exclusive": {"$ref": "#/$defs/semver"},
        "descriptor_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contracts",
        "python_versions",
        "platforms",
        "required_extensions",
        "optional_extensions",
        "plugin_dependencies"
      ],
      "properties": {
        "contracts": {
          "type": "array",
          "minItems": 6,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/contract_ref"}
        },
        "python_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^3\\.[0-9]+$"}
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["linux", "macos", "windows"]}
        },
        "required_extensions": {"$ref": "#/$defs/namespaced_set"},
        "optional_extensions": {"$ref": "#/$defs/namespaced_set"},
        "plugin_dependencies": {
          "type": "array",
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/plugin_dependency"}
        }
      }
    },
    "format_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format_id", "major", "minor_minimum", "minor_maximum", "required_features"],
      "properties": {
        "format_id": {"$ref": "#/$defs/namespaced"},
        "major": {"const": 1},
        "minor_minimum": {"$ref": "#/$defs/quantity"},
        "minor_maximum": {"$ref": "#/$defs/quantity"},
        "required_features": {"$ref": "#/$defs/namespaced_set"}
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "quantifiers",
        "expression_kinds",
        "relation_kinds",
        "maximum_polynomial_degree",
        "maximum_quantifier_depth",
        "maximum_variables",
        "supports_ambiguity",
        "requires_exact_arithmetic",
        "required_theory_features",
        "forbidden_theory_features"
      ],
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"enum": ["boolean", "complex", "graph", "integer", "polynomial", "rational", "real", "set"]}
        },
        "quantifiers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["exists", "forall", "mixed", "none"]}
        },
        "expression_kinds": {"$ref": "#/$defs/namespaced_set"},
        "relation_kinds": {"$ref": "#/$defs/namespaced_set"},
        "maximum_polynomial_degree": {"$ref": "#/$defs/quantity"},
        "maximum_quantifier_depth": {"$ref": "#/$defs/quantity"},
        "maximum_variables": {"$ref": "#/$defs/quantity"},
        "supports_ambiguity": {"type": "boolean"},
        "requires_exact_arithmetic": {"type": "boolean"},
        "required_theory_features": {"$ref": "#/$defs/namespaced_set"},
        "forbidden_theory_features": {"$ref": "#/$defs/namespaced_set"}
      }
    },
    "cost_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "per_variable",
        "per_expression_node",
        "per_quantifier",
        "per_goal",
        "ambiguity_surcharge",
        "maximum",
        "confidence_ppm"
      ],
      "properties": {
        "base": {"$ref": "#/$defs/quantity"},
        "per_variable": {"$ref": "#/$defs/quantity"},
        "per_expression_node": {"$ref": "#/$defs/quantity"},
        "per_quantifier": {"$ref": "#/$defs/quantity"},
        "per_goal": {"$ref": "#/$defs/quantity"},
        "ambiguity_surcharge": {"$ref": "#/$defs/quantity"},
        "maximum": {"$ref": "#/$defs/quantity"},
        "confidence_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "kind",
        "theories",
        "priority",
        "fragment",
        "evidence_formats",
        "certificate_formats",
        "cost_model"
      ],
      "properties": {
        "capability_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["decision", "construction", "verification", "explanation"]},
        "theories": {"$ref": "#/$defs/namespaced_set"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "fragment": {"$ref": "#/$defs/fragment"},
        "evidence_formats": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/format_support"}
        },
        "certificate_formats": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/format_support"}
        },
        "cost_model": {"$ref": "#/$defs/cost_model"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "component_id",
        "request_contract_ids",
        "response_contract_ids",
        "response_schema",
        "budget_policy",
        "cancellation",
        "replay_modes",
        "effect_kinds",
        "authority",
        "outcomes"
      ],
      "properties": {
        "operation": {"enum": ["plan_cost", "solve", "check", "explain"]},
        "component_id": {"$ref": "#/$defs/id"},
        "request_contract_ids": {"$ref": "#/$defs/contract_id_set"},
        "response_contract_ids": {"$ref": "#/$defs/contract_id_set"},
        "response_schema": {"$ref": "#/$defs/namespaced"},
        "budget_policy": {"enum": ["none", "child_lease_required"]},
        "cancellation": {"enum": ["not_applicable", "cooperative_required"]},
        "replay_modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["deterministic", "seeded"]}
        },
        "effect_kinds": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["environment", "filesystem", "network", "process", "solver"]}
        },
        "authority": {"enum": ["none", "producer_report", "checker_attestation"]},
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "enum": [
              "completed",
              "verified",
              "invalid",
              "unsupported",
              "ambiguous",
              "inconclusive",
              "cancelled",
              "exhausted",
              "truncated",
              "verifier_failed",
              "disagreement",
              "error"
            ]
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "reentrant",
        "thread_safe",
        "maximum_concurrency",
        "state_persistence",
        "isolation",
        "initialization",
        "shutdown_timeout_us"
      ],
      "properties": {
        "scope": {"enum": ["invocation", "session", "process"]},
        "reentrant": {"type": "boolean"},
        "thread_safe": {"type": "boolean"},
        "maximum_concurrency": {"type": "integer", "minimum": 1, "maximum": 10000},
        "state_persistence": {"enum": ["none", "content_addressed"]},
        "isolation": {"enum": ["in_process", "subprocess_required"]},
        "initialization": {"enum": ["deterministic", "seeded"]},
        "shutdown_timeout_us": {"$ref": "#/$defs/quantity"}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mode", "policy_id", "reason"],
      "properties": {
        "kind": {"enum": ["environment", "filesystem", "network", "process", "solver"]},
        "mode": {"enum": ["none", "declared"]},
        "policy_id": {
          "anyOf": [
            {"$ref": "#/$defs/namespaced"},
            {"type": "null"}
          ]
        },
        "reason": {
          "anyOf": [
            {"$ref": "#/$defs/reason"},
            {"type": "null"}
          ]
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_modes",
        "seed_policy",
        "configuration_sha256",
        "descriptor_basis_sha256"
      ],
      "properties": {
        "supported_modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["deterministic", "seeded"]}
        },
        "seed_policy": {"enum": ["forbidden", "explicit_required_when_seeded"]},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "descriptor_basis_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_bytes",
        "canonical_nodes",
        "canonical_nesting",
        "entities",
        "items_per_array",
        "string_codepoints",
        "validation_seconds",
        "memory_mb"
      ],
      "properties": {
        "input_bytes": {"$ref": "#/$defs/quantity"},
        "canonical_nodes": {"$ref": "#/$defs/quantity"},
        "canonical_nesting": {"$ref": "#/$defs/quantity"},
        "entities": {"$ref": "#/$defs/quantity"},
        "items_per_array": {"$ref": "#/$defs/quantity"},
        "string_codepoints": {"$ref": "#/$defs/quantity"},
        "validation_seconds": {"$ref": "#/$defs/quantity"},
        "memory_mb": {"$ref": "#/$defs/quantity"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/trust-transition-catalogue-v1.schema.json",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tier": {
      "enum": [
        "none",
        "producer_report",
        "solver_verdict",
        "checker_attestation",
        "external_proof_assistant"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "sha256"],
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^MH-C-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_issuers",
        "allowed_statuses",
        "mutation_ids",
        "on_failure_tier",
        "operation",
        "positive_control_ids",
        "required_binding_roles",
        "required_contracts",
        "requires_fresh",
        "requires_independent",
        "source_tier",
        "target_tier",
        "transition_id"
      ],
      "properties": {
        "allowed_issuers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "allowed_statuses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "completed",
              "disagreement",
              "error",
              "exhausted",
              "invalid",
              "unsupported",
              "verified"
            ]
          }
        },
        "mutation_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "on_failure_tier": {
          "$ref": "#/$defs/tier"
        },
        "operation": {
          "enum": ["downgrade", "issue", "preserve"]
        },
        "positive_control_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "required_binding_roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "required_contracts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contract"
          }
        },
        "requires_fresh": {
          "type": "boolean"
        },
        "requires_independent": {
          "type": "boolean"
        },
        "source_tier": {
          "$ref": "#/$defs/tier"
        },
        "target_tier": {
          "$ref": "#/$defs/tier"
        },
        "transition_id": {
          "type": "string",
          "pattern": "^transition\\.[a-z][a-z0-9_.-]{0,95}$"
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "expected_decision",
        "expected_reason",
        "expected_tier",
        "mutation_class",
        "mutation_id",
        "transition_ids"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "expected_decision": {
          "enum": ["downgraded", "rejected"]
        },
        "expected_reason": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "expected_tier": {
          "$ref": "#/$defs/tier"
        },
        "mutation_class": {
          "enum": [
            "artifact",
            "authority",
            "budget",
            "canonical",
            "effect",
            "freshness",
            "identity",
            "independence",
            "provenance",
            "semantic",
            "status",
            "structure"
          ]
        },
        "mutation_id": {
          "$ref": "#/$defs/id"
        },
        "transition_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^transition\\.[a-z][a-z0-9_.-]{0,95}$"
          }
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_issuer",
        "maximum_tier",
        "mutation_ids",
        "role",
        "surface_id"
      ],
      "properties": {
        "authority_issuer": {
          "const": false
        },
        "maximum_tier": {
          "$ref": "#/$defs/tier"
        },
        "mutation_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "role": {
          "enum": ["effect_boundary", "producer", "transport"]
        },
        "surface_id": {
          "$ref": "#/$defs/id"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "effects",
    "mutations",
    "schema",
    "tiers",
    "transitions"
  ],
  "properties": {
    "contract": {
      "$ref": "#/$defs/contract"
    },
    "effects": {
      "type": "array",
      "minItems": 11,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "mutations": {
      "type": "array",
      "minItems": 24,
      "maxItems": 2048,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/mutation"
      }
    },
    "schema": {
      "const": "mathhead.trust-transition-catalogue.v1"
    },
    "tiers": {
      "const": [
        "none",
        "producer_report",
        "solver_verdict",
        "checker_attestation",
        "external_proof_assistant"
      ]
    },
    "transitions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/transition"
      }
    }
  }
}

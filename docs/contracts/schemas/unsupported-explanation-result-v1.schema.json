{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/unsupported-explanation-result-v1.schema.json",
  "title": "MathHead unsupported explanation result v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "mathhead.unsupported-explanation-result.v1"},
    "contract_id": {"const": "MH-C-UNSUPPORTED-EXPLANATION-001"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_normalization_contract_id": {"const": "MH-C-CANONICAL-NORMALIZATION-001"},
    "canonical_normalization_contract_sha256": {"$ref": "#/$defs/sha256"},
    "proof_obligation_contract_id": {"const": "MH-C-PROOF-OBLIGATION-DECOMPOSITION-001"},
    "proof_obligation_contract_sha256": {"$ref": "#/$defs/sha256"},
    "domain_assumption_contract_id": {"const": "MH-C-DOMAIN-ASSUMPTION-NORMALIZATION-001"},
    "domain_assumption_contract_sha256": {"$ref": "#/$defs/sha256"},
    "reading_analysis_contract_id": {"const": "MH-C-READING-ANALYSIS-002"},
    "reading_analysis_contract_sha256": {"$ref": "#/$defs/sha256"},
    "problem_intake_contract_id": {"const": "MH-C-PROBLEM-INTAKE-001"},
    "problem_intake_contract_sha256": {"$ref": "#/$defs/sha256"},
    "problem_ir_contract_id": {"const": "MH-C-PROBLEM-IR-002"},
    "problem_ir_contract_sha256": {"$ref": "#/$defs/sha256"},
    "catalogue_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["explained", "invalid", "exhausted"]},
    "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 128},
    "input_result_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "normalization_result": {
      "anyOf": [{"type": "object"}, {"type": "null"}]
    },
    "ambiguity_status": {"enum": ["unambiguous", "unresolved", "resolved", null]},
    "selected_reading_id": {
      "anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
    },
    "candidates": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/diagnostic"}
    },
    "result_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "mathematical_authority": {"const": false}
  },
  "required": [
    "schema",
    "contract_id",
    "contract_sha256",
    "canonical_normalization_contract_id",
    "canonical_normalization_contract_sha256",
    "proof_obligation_contract_id",
    "proof_obligation_contract_sha256",
    "domain_assumption_contract_id",
    "domain_assumption_contract_sha256",
    "reading_analysis_contract_id",
    "reading_analysis_contract_sha256",
    "problem_intake_contract_id",
    "problem_intake_contract_sha256",
    "problem_ir_contract_id",
    "problem_ir_contract_sha256",
    "catalogue_sha256",
    "status",
    "reason_code",
    "input_result_sha256",
    "normalization_result",
    "ambiguity_status",
    "selected_reading_id",
    "candidates",
    "diagnostics",
    "result_sha256",
    "mathematical_authority"
  ],
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "explained"}}, "required": ["status"]},
      "then": {
        "properties": {
          "reason_code": {"const": "EXPLAINED"},
          "input_result_sha256": {"$ref": "#/$defs/sha256"},
          "normalization_result": {"type": "object"},
          "candidates": {"type": "array", "minItems": 1},
          "diagnostics": {"maxItems": 0},
          "result_sha256": {"$ref": "#/$defs/sha256"}
        }
      },
      "else": {
        "properties": {
          "input_result_sha256": {"type": "null"},
          "normalization_result": {"type": "null"},
          "ambiguity_status": {"type": "null"},
          "selected_reading_id": {"type": "null"},
          "candidates": {"maxItems": 0},
          "diagnostics": {"type": "array", "minItems": 1, "maxItems": 32},
          "result_sha256": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reading_id": {"$ref": "#/$defs/id"},
        "source_graph_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_graph_sha256": {"$ref": "#/$defs/sha256"},
        "unsupported_semantic_sha256s": {
          "type": "array",
          "maxItems": 800000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "targets": {
          "type": "array",
          "maxItems": 2400000,
          "items": {"$ref": "unsupported-target-v1.schema.json"}
        },
        "explanations": {
          "type": "array",
          "maxItems": 2400000,
          "items": {"$ref": "unsupported-explanation-v1.schema.json"}
        },
        "explanation_set_sha256": {"$ref": "#/$defs/sha256"},
        "mathematical_authority": {"const": false}
      },
      "required": [
        "reading_id",
        "source_graph_sha256",
        "semantic_graph_sha256",
        "unsupported_semantic_sha256s",
        "targets",
        "explanations",
        "explanation_set_sha256",
        "mathematical_authority"
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 128},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "message": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "required": ["code", "path", "message"]
    }
  }
}

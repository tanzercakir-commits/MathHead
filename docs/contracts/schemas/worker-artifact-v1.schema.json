{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathhead.dev/schemas/worker-artifact-v1.schema.json",
  "title": "MathHead Worker Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "role", "media_type", "original_bytes", "retained_bytes", "omitted_bytes", "retained_sha256", "artifact_sha256", "mathematical_authority"],
  "properties": {
    "schema": {"const": "mathhead.worker-artifact.v1"},
    "role": {"enum": ["stdout", "stderr"]},
    "media_type": {"const": "application/octet-stream"},
    "original_bytes": {"$ref": "#/$defs/quantity"}, "retained_bytes": {"$ref": "#/$defs/quantity"}, "omitted_bytes": {"$ref": "#/$defs/quantity"},
    "retained_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "mathematical_authority": {"const": false}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "quantity": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}
}

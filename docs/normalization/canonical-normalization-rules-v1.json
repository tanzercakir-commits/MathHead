{
  "schema": "mathhead.canonical-normalization-rules.v1",
  "catalogue_id": "mathhead.canonical-normalization-rules.v1",
  "policy": "Only lexical alpha conversion, core logical or symmetric-relation commutativity, and provenance-preserving occurrence ordering are authorized; names never imply algebraic laws.",
  "rules": [
    {
      "rule_id": "mh.canonical.alpha.quantified-binder",
      "rule_kind": "alpha",
      "match_registry": "variables",
      "match_kind": "bound",
      "match_value": null,
      "minimum_arity": 1,
      "maximum_arity": 100000,
      "effect": "replace_bound_reference",
      "authority_basis": "lexical_scope_semantics",
      "description": "Replace each quantified bound-variable reference by its capture-safe lexical depth and declared binder position while retaining domain and role.",
      "supported": true,
      "mathematical_authority": false
    },
    {
      "rule_id": "mh.canonical.alpha.definition-parameter",
      "rule_kind": "alpha",
      "match_registry": "definitions",
      "match_kind": "parameter",
      "match_value": null,
      "minimum_arity": 0,
      "maximum_arity": 100000,
      "effect": "replace_parameter_reference",
      "authority_basis": "lexical_scope_semantics",
      "description": "Replace definition-parameter references by capture-safe declared parameter positions without changing parameter order, domain, or body scope.",
      "supported": true,
      "mathematical_authority": false
    },
    {
      "rule_id": "mh.canonical.alpha.witness-slot",
      "rule_kind": "alpha",
      "match_registry": "witness_placeholders",
      "match_kind": "symbolic",
      "match_value": null,
      "minimum_arity": 0,
      "maximum_arity": 100000,
      "effect": "replace_witness_reference",
      "authority_basis": "representation_policy",
      "description": "Replace a symbolic witness-placeholder spelling by its ordered local-context slot without constructing or evaluating a witness.",
      "supported": true,
      "mathematical_authority": false
    },
    {
      "rule_id": "mh.canonical.commutative.logical-and",
      "rule_kind": "commutative",
      "match_registry": "statements",
      "match_kind": "logical",
      "match_value": "and",
      "minimum_arity": 2,
      "maximum_arity": 100000,
      "effect": "sort_operands",
      "authority_basis": "core_problem_ir_semantics",
      "description": "Order conjunction operands by complete normalized bytes while preserving duplicate occurrences and without flattening nested conjunctions.",
      "supported": true,
      "mathematical_authority": false
    },
    {
      "rule_id": "mh.canonical.commutative.logical-or",
      "rule_kind": "commutative",
      "match_registry": "statements",
      "match_kind": "logical",
      "match_value": "or",
      "minimum_arity": 2,
      "maximum_arity": 100000,
      "effect": "sort_operands",
      "authority_basis": "core_problem_ir_semantics",
      "description": "Order disjunction operands by complete normalized bytes while preserving duplicate occurrences, choice duties, and nested structure.",
      "supported": true,
      "mathematical_authority": false
    },
    {
      "rule_id": "mh.canonical.commutative.logical-iff",
      "rule_kind": "commutative",
      "match_registry": "statements",
      "match_kind": "logical",
      "match_value": "iff",
      "minimum_arity": 2,
      "maximum_arity": 2,
      "effect": "sort_operands",
      "authority_basis": "core_problem_ir_semantics",
      "description": "Order the two biconditional sides by complete normalized bytes while preserving the original two-direction obligation trace.",
      "supported": true,
      "mathematical_authority": false
    },
    {
      "rule_id": "mh.canonical.commutative.relation-equal",
      "rule_kind": "commutative",
      "match_registry": "relations",
      "match_kind": "relation",
      "match_value": "equal",
      "minimum_arity": 2,
      "maximum_arity": 2,
      "effect": "sort_operands",
      "authority_basis": "core_problem_ir_semantics",
      "description": "Order the two equality operands by complete normalized bytes without simplification, evaluation, or duplicate collapse.",
      "supported": true,
      "mathematical_authority": false
    },
    {
      "rule_id": "mh.canonical.commutative.relation-not-equal",
      "rule_kind": "commutative",
      "match_registry": "relations",
      "match_kind": "relation",
      "match_value": "not_equal",
      "minimum_arity": 2,
      "maximum_arity": 2,
      "effect": "sort_operands",
      "authority_basis": "core_problem_ir_semantics",
      "description": "Order the two disequality operands by complete normalized bytes without negation rewriting, evaluation, or duplicate collapse.",
      "supported": true,
      "mathematical_authority": false
    },
    {
      "rule_id": "mh.canonical.order.assumption-facts",
      "rule_kind": "ordering",
      "match_registry": "assumption_facts",
      "match_kind": "all",
      "match_value": null,
      "minimum_arity": 0,
      "maximum_arity": 400000,
      "effect": "sort_occurrences",
      "authority_basis": "representation_policy",
      "description": "Order assumption-fact occurrences by role, normalized semantic bytes, origin class, and original occurrence tie-break while retaining multiplicity and provenance.",
      "supported": true,
      "mathematical_authority": false
    },
    {
      "rule_id": "mh.canonical.order.local-hypotheses",
      "rule_kind": "ordering",
      "match_registry": "local_hypotheses",
      "match_kind": "all",
      "match_value": null,
      "minimum_arity": 0,
      "maximum_arity": 400000,
      "effect": "sort_occurrences",
      "authority_basis": "representation_policy",
      "description": "Order inherited local-hypothesis occurrences by complete normalized bytes and original occurrence tie-break while retaining every source statement.",
      "supported": true,
      "mathematical_authority": false
    },
    {
      "rule_id": "mh.canonical.preserve.ordered",
      "rule_kind": "preserve",
      "match_registry": "any",
      "match_kind": "ordered",
      "match_value": null,
      "minimum_arity": 0,
      "maximum_arity": 100000,
      "effect": "preserve_order",
      "authority_basis": "core_problem_ir_semantics",
      "description": "Preserve every operand, binder, goal, graph, child, prerequisite, strategy, and source order not explicitly authorized by another exact rule.",
      "supported": true,
      "mathematical_authority": false
    },
    {
      "rule_id": "mh.canonical.preserve.opaque",
      "rule_kind": "preserve",
      "match_registry": "any",
      "match_kind": "opaque",
      "match_value": null,
      "minimum_arity": 0,
      "maximum_arity": 100000,
      "effect": "preserve_opaque",
      "authority_basis": "representation_policy",
      "description": "Retain unsupported, future, extension, or opaque structure byte-exact in trace data and exclude it from unreviewed semantic rewriting.",
      "supported": false,
      "mathematical_authority": false
    }
  ],
  "mathematical_authority": false
}

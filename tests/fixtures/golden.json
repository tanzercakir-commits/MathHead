{
  "_comment": "Golden senaryolar — bilinen girdi→çıktı kilidi (regresyon çiti). Her giriş route(task,payload) sonucunu 'expect' ile kıyaslar; yalnız verilen alanlar denetlenir. Deterministik olmayan alan (witness) KULLANILMAZ.",
  "cases": [
    {"name": "entailment-modus-ponens", "task": "entailment",
     "payload": {"premises": ["p", "implies(p,q)"], "conclusion": "q"},
     "expect": {"status": "valid", "reason_code": "ENTAILED"}},
    {"name": "entailment-invalid", "task": "entailment",
     "payload": {"premises": ["p"], "conclusion": "q"},
     "expect": {"status": "invalid", "reason_code": "COUNTEREXAMPLE_FOUND"}},
    {"name": "syllogism", "task": "entailment",
     "payload": {"premises": ["forall(x, implies(Man(x), Mortal(x)))", "Man(socrates)"],
                 "conclusion": "Mortal(socrates)"},
     "expect": {"status": "valid"}},
    {"name": "consistency-contradiction", "task": "consistency",
     "payload": {"statements": ["p", "not(p)"]},
     "expect": {"status": "unsat", "reason_code": "CONTRADICTION"}},
    {"name": "classify-tautology", "task": "classify",
     "payload": {"formula": "p or not(p)"},
     "expect": {"status": "tautology", "reason_code": "TAUTOLOGY"}},
    {"name": "classify-contradiction", "task": "classify",
     "payload": {"formula": "p and not(p)"},
     "expect": {"status": "contradiction", "reason_code": "CONTRADICTION"}},
    {"name": "equivalent-demorgan", "task": "equivalent",
     "payload": {"a": "not(p or q)", "b": "not(p) and not(q)"},
     "expect": {"status": "equivalent", "reason_code": "EQUIVALENT"}},

    {"name": "simplify-trig", "task": "simplify",
     "payload": {"expression": "sin(x)**2 + cos(x)**2"},
     "expect": {"status": "ok", "result": "1"}},
    {"name": "solve-quadratic", "task": "solve",
     "payload": {"equation": "x**2 == 4", "symbol": "x"},
     "expect": {"status": "ok", "result": ["-2", "2"]}},
    {"name": "differentiate", "task": "differentiate",
     "payload": {"expression": "x**3 + 2*x", "symbol": "x", "order": 1},
     "expect": {"status": "ok", "result": "3*x**2 + 2"}},
    {"name": "integrate", "task": "integrate",
     "payload": {"expression": "2*x", "symbol": "x"},
     "expect": {"status": "ok", "result": "x**2"}},
    {"name": "limit-sinc", "task": "limit",
     "payload": {"expression": "sin(x)/x", "symbol": "x", "point": "0"},
     "expect": {"status": "ok", "result": "1"}},
    {"name": "limit-at-infinity", "task": "limit",
     "payload": {"expression": "1/x", "symbol": "x", "point": "oo"},
     "expect": {"status": "ok", "result": "0"}},
    {"name": "series-exp", "task": "series",
     "payload": {"expression": "exp(x)", "symbol": "x", "point": "0", "order": 5},
     "expect": {"status": "ok", "result": "x**4/24 + x**3/6 + x**2/2 + x + 1"}},
    {"name": "solve-system", "task": "solve_system",
     "payload": {"equations": ["x + y == 10", "x - y == 2"], "symbols": ["x", "y"]},
     "expect": {"status": "ok", "result": [{"x": "6", "y": "4"}]}},

    {"name": "determinant", "task": "determinant",
     "payload": {"matrix": [["1", "2"], ["3", "4"]]},
     "expect": {"status": "ok", "result": "-2"}},
    {"name": "determinant-symbolic", "task": "determinant",
     "payload": {"matrix": [["a", "b"], ["c", "d"]]},
     "expect": {"status": "ok", "result": "a*d - b*c"}},
    {"name": "inverse-singular", "task": "matrix_inverse",
     "payload": {"matrix": [["1", "2"], ["2", "4"]]},
     "expect": {"status": "error", "reason_code": "COMPUTE_FAILED"}},
    {"name": "matmul", "task": "matrix_multiply",
     "payload": {"a": [["1", "2"], ["3", "4"]], "b": [["5", "6"], ["7", "8"]]},
     "expect": {"status": "ok", "result": [["19", "22"], ["43", "50"]]}},
    {"name": "matsolve-no-solution", "task": "matrix_solve",
     "payload": {"matrix": [["1", "1"], ["1", "1"]], "rhs": ["1", "2"]},
     "expect": {"status": "ok", "result": []}},
    {"name": "nullspace", "task": "nullspace",
     "payload": {"matrix": [["1", "2"], ["2", "4"]]},
     "expect": {"status": "ok", "result": [["-2", "1"]]}},

    {"name": "gcd", "task": "gcd", "payload": {"a": "48", "b": "36"},
     "expect": {"status": "ok", "result": 12}},
    {"name": "is-prime", "task": "is_prime", "payload": {"n": "97"},
     "expect": {"status": "ok", "result": true}},
    {"name": "factorize", "task": "factorize", "payload": {"n": "360"},
     "expect": {"status": "ok", "result": [{"prime": 2, "exponent": 3}, {"prime": 3, "exponent": 2}, {"prime": 5, "exponent": 1}]}},
    {"name": "modinv-none", "task": "modular_inverse", "payload": {"a": "4", "m": "8"},
     "expect": {"status": "error", "reason_code": "COMPUTE_FAILED"}},
    {"name": "crt", "task": "chinese_remainder",
     "payload": {"moduli": ["3", "5", "7"], "residues": ["2", "3", "2"]},
     "expect": {"status": "ok", "result": {"x": 23, "modulus": 105}}},
    {"name": "diophantine-none", "task": "linear_diophantine",
     "payload": {"a": "2", "b": "4", "c": "5"},
     "expect": {"status": "ok", "result": []}},

    {"name": "combinations", "task": "combinations", "payload": {"n": "10", "k": "3"},
     "expect": {"status": "ok", "result": 120}},
    {"name": "factorial", "task": "factorial", "payload": {"n": "6"},
     "expect": {"status": "ok", "result": 720}},
    {"name": "partition", "task": "partition_count", "payload": {"n": "10"},
     "expect": {"status": "ok", "result": 42}},
    {"name": "recurrence-geometric", "task": "solve_recurrence",
     "payload": {"recurrence": "y(n) = 2*y(n-1)", "func": "y", "var": "n", "initial": {"0": "1"}},
     "expect": {"status": "ok", "result": "2**n"}},

    {"name": "pigeonhole", "task": "pigeonhole", "payload": {"n": 4},
     "expect": {"status": "unsat", "reason_code": "PROVEN_IMPOSSIBLE"}}
  ]
}
